          },
          "Message": {
            "type": "string",
            "title": "Message"
          },
          "AttemptsLeft": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Attemptsleft"
          },
          "Fields": {
