{
  "openapi": "3.1.0",
  "info": {
    "title": "FMR Mock API",
    "description": "\nMock of the **FMR** APIs used by the Meitav Trade agent for **password reset** and **username recovery**.\n\n**Authorize first:** click **Authorize** and paste the API key (`MOCK_API_KEY`).\n\n### Flow\n1. `ValidateExToken`: get `RequestID` + `RToken`\n2. `AccountVerification`: verify the 6-digit trade account, get the cards\n3. `ResetPassword` (→ 210, SMS) or `RecoverUserID` (→ 209, email) with `UserId` = card's last 3 digits\n\n### Test accounts\n| Account | Cards | Result |\n|---|---|---|\n| `001234` | 771 | Happy path (one card) |\n| `012345` | 025, 418 | Two cards: customer picks |\n| `054321` | 309 | RecoverUserID → **427** (no email) |\n| `067890` | 552 (inactive), 860 | 552 → **436** |\n| `098765` | 144 | TIK = Y (managed account) |\n| any other | – | **404**, 3 attempts then **423** |\n\n### Status codes\nBy default the HTTP status equals the FMR `Status` (e.g. 210, 436). If the server runs with\n`FMR_STATUS_IN_HTTP=false`, every response is HTTP 200 and the code is only in `Status`.\n\nOnly **209, 210, 427, 436** come from the spec; other error codes are placeholders until FMR confirms them.\n",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Mock helpers"
        ],
        "summary": "Health check (no API key)",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/ValidateExToken": {
      "post": {
        "tags": [
          "FMR"
        ],
        "summary": "Validate the MToken and open an FMR session",
        "description": "Returns the RequestID + RToken used on every later call. They don't expire.",
        "operationId": "validate_ex_token_ValidateExToken_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ValidateExTokenIn"
              },
              "examples": {
                "success": {
                  "summary": "Successful validation",
                  "value": {
                    "ExSessionID": "test-1",
                    "MToken": "eyJ.mock"
                  }
                },
                "failed": {
                  "summary": "Failed login (401)",
                  "value": {
                    "ExSessionID": "test-1",
                    "MToken": "invalid"
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Session opened",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenOut"
                }
              }
            }
          },
          "400": {
            "description": "BAD_REQUEST",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                },
                "example": {
                  "Status": 400,
                  "Error": "BAD_REQUEST",
                  "Message": "Invalid or missing fields",
                  "Fields": [
                    "RToken"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "INVALID_MTOKEN",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                },
                "example": {
                  "Status": 401,
                  "Error": "INVALID_MTOKEN",
                  "Message": "MToken rejected (invalid)"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    },
    "/AccountVerification": {
      "post": {
        "tags": [
          "FMR"
        ],
        "summary": "Verify the trade account and return its cards",
        "operationId": "account_verification_AccountVerification_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AccountVerificationIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Account verified",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VerificationOut"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_ACCOUNT_FORMAT",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                },
                "example": {
                  "Status": 400,
                  "Error": "INVALID_ACCOUNT_FORMAT",
                  "Message": "Account must be exactly 6 digits"
                }
              }
            }
          },
          "401": {
            "description": "INVALID_TOKEN",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                },
                "example": {
                  "Status": 401,
                  "Error": "INVALID_TOKEN",
                  "Message": "RequestID/RToken not recognised"
                }
              }
            }
          },
          "404": {
            "description": "ACCOUNT_NOT_FOUND",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                },
                "example": {
                  "Status": 404,
                  "Error": "ACCOUNT_NOT_FOUND",
                  "Message": "Account does not match the authenticated customer",
                  "AttemptsLeft": 2
                }
              }
            }
          },
          "423": {
            "description": "TOO_MANY_ATTEMPTS",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                },
                "example": {
                  "Status": 423,
                  "Error": "TOO_MANY_ATTEMPTS",
                  "Message": "Maximum verification attempts reached",
                  "AttemptsLeft": 0
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    },
    "/ResetPassword": {
      "post": {
        "tags": [
          "FMR"
        ],
        "summary": "Send the password-reset SMS",
        "operationId": "reset_password_ResetPassword_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ActionIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "210": {
            "description": "SMS sent",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActionOut"
                },
                "example": {
                  "Status": 210,
                  "Message": "Password reset SMS sent to the verified phone number"
                }
              }
            }
          },
          "400": {
            "description": "BAD_REQUEST",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                },
                "example": {
                  "Status": 400,
                  "Error": "BAD_REQUEST",
                  "Message": "Invalid or missing fields",
                  "Fields": [
                    "RToken"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "INVALID_TOKEN",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                },
                "example": {
                  "Status": 401,
                  "Error": "INVALID_TOKEN",
                  "Message": "RequestID/RToken not recognised"
                }
              }
            }
          },
          "404": {
            "description": "CARD_NOT_FOUND",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                },
                "example": {
                  "Status": 404,
                  "Error": "CARD_NOT_FOUND",
                  "Message": "UserId does not match a card on this account"
                }
              }
            }
          },
          "409": {
            "description": "ACCOUNT_NOT_VERIFIED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                },
                "example": {
                  "Status": 409,
                  "Error": "ACCOUNT_NOT_VERIFIED",
                  "Message": "Call AccountVerification first"
                }
              }
            }
          },
          "436": {
            "description": "CARD_NOT_ACTIVE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                },
                "example": {
                  "Status": 436,
                  "Error": "CARD_NOT_ACTIVE",
                  "Message": "Selected card is not active"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    },
    "/RecoverUserID": {
      "post": {
        "tags": [
          "FMR"
        ],
        "summary": "Send the username-recovery email",
        "operationId": "recover_user_id_RecoverUserID_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ActionIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "209": {
            "description": "Email sent",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActionOut"
                },
                "example": {
                  "Status": 209,
                  "Message": "Username recovery email sent"
                }
              }
            }
          },
          "400": {
            "description": "BAD_REQUEST",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                },
                "example": {
                  "Status": 400,
                  "Error": "BAD_REQUEST",
                  "Message": "Invalid or missing fields",
                  "Fields": [
                    "RToken"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "INVALID_TOKEN",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                },
                "example": {
                  "Status": 401,
                  "Error": "INVALID_TOKEN",
                  "Message": "RequestID/RToken not recognised"
                }
              }
            }
          },
          "404": {
            "description": "CARD_NOT_FOUND",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                },
                "example": {
                  "Status": 404,
                  "Error": "CARD_NOT_FOUND",
                  "Message": "UserId does not match a card on this account"
                }
              }
            }
          },
          "409": {
            "description": "ACCOUNT_NOT_VERIFIED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                },
                "example": {
                  "Status": 409,
                  "Error": "ACCOUNT_NOT_VERIFIED",
                  "Message": "Call AccountVerification first"
                }
              }
            }
          },
          "427": {
            "description": "NO_EMAIL",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                },
                "example": {
                  "Status": 427,
                  "Error": "NO_EMAIL",
                  "Message": "No email on account; username cannot be sent"
                }
              }
            }
          },
          "436": {
            "description": "CARD_NOT_ACTIVE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                },
                "example": {
                  "Status": 436,
                  "Error": "CARD_NOT_ACTIVE",
                  "Message": "Selected card is not active"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    },
    "/mock/accounts": {
