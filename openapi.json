    }
  },
  "components": {
    "schemas": {
      "AccountVerificationIn": {
        "properties": {
          "RequestID": {
            "type": "string",
            "title": "Requestid",
            "description": "From ValidateExToken"
          },
          "RToken": {
            "type": "string",
            "title": "Rtoken",
            "description": "From ValidateExToken"
          },
          "Account": {
            "type": "string",
            "title": "Account",
            "description": "Trade account number, exactly 6 digits (pad with leading zeros)",
            "examples": [
              "012345"
            ]
          }
        },
        "type": "object",
        "required": [
          "RequestID",
          "RToken",
          "Account"
        ],
        "title": "AccountVerificationIn"
      },
      "ActionIn": {
        "properties": {
          "RequestID": {
            "type": "string",
            "title": "Requestid",
            "description": "From ValidateExToken"
          },
          "RToken": {
            "type": "string",
            "title": "Rtoken",
            "description": "From ValidateExToken"
          },
          "UserId": {
            "type": "string",
            "title": "Userid",
            "description": "Last 3 digits of the selected card",
            "examples": [
              "418"
            ]
          }
        },
        "type": "object",
        "required": [
          "RequestID",
          "RToken",
          "UserId"
        ],
        "title": "ActionIn"
      },
      "ActionOut": {
        "properties": {
          "Status": {
            "type": "integer",
            "title": "Status"
          },
          "Message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "Status",
          "Message"
        ],
        "title": "ActionOut"
      },
      "CardOut": {
        "properties": {
          "Last3": {
            "type": "string",
            "title": "Last3"
          },
          "PermissionCode": {
            "type": "string",
            "title": "Permissioncode"
          }
        },
        "type": "object",
        "required": [
          "Last3",
          "PermissionCode"
        ],
        "title": "CardOut"
      },
      "ErrorOut": {
        "properties": {
          "Status": {
            "type": "integer",
            "title": "Status"
          },
          "Error": {
            "type": "string",
            "title": "Error"
          },
          "Message": {
            "type": "string",
            "title": "Message"
          },
          "AttemptsLeft": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Attemptsleft"
          },
          "Fields": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fields"
          }
        },
        "type": "object",
        "required": [
          "Status",
          "Error",
          "Message"
        ],
        "title": "ErrorOut"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "TokenOut": {
        "properties": {
          "Status": {
            "type": "integer",
            "title": "Status",
            "default": 200,
            "examples": [
              200
            ]
          },
          "RequestID": {
            "type": "string",
            "title": "Requestid"
          },
          "RToken": {
            "type": "string",
            "title": "Rtoken"
          }
        },
        "type": "object",
        "required": [
          "RequestID",
          "RToken"
        ],
        "title": "TokenOut"
      },
      "ValidateExTokenIn": {
        "properties": {
          "ExSessionID": {
            "type": "string",
            "title": "Exsessionid",
            "description": "GUID Meitav sends with the MToken"
          },
          "MToken": {
            "type": "string",
            "title": "Mtoken",
            "description": "JWT Meitav created after authenticating the customer. Any value works; `invalid` or `expired` simulate a failed login."
          }
        },
        "type": "object",
        "required": [
          "ExSessionID",
          "MToken"
        ],
        "title": "ValidateExTokenIn"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "VerificationOut": {
        "properties": {
          "Status": {
            "type": "integer",
            "title": "Status",
            "default": 200,
            "examples": [
              200
            ]
          },
          "Cards": {
            "items": {
              "$ref": "#/components/schemas/CardOut"
            },
            "type": "array",
            "title": "Cards"
          },
          "Email": {
            "type": "string",
            "title": "Email",
            "description": "Y/N: account has an email address"
          },
          "TIK": {
            "type": "string",
            "title": "Tik",
            "description": "Y/N: IRA / managed account"
          },
          "FirstName": {
            "type": "string",
            "title": "Firstname"
          },
          "LastName": {
            "type": "string",
            "title": "Lastname"
          }
        },
        "type": "object",
        "required": [
          "Cards",
          "Email",
          "TIK",
          "FirstName",
          "LastName"
        ],
        "title": "VerificationOut"
      }
    },
    "securitySchemes": {
      "APIKeyHeader": {
        "type": "apiKey",
        "description": "Value of `MOCK_API_KEY` (Render → Environment).",
        "in": "header",
        "name": "X-API-Key"
      }
    }
  },
  "tags": [
    {
      "name": "FMR",
      "description": "Mocked FMR endpoints"
    },
    {
      "name": "Mock helpers",
      "description": "Test-only utilities (not part of FMR)"
    }
  ],
  "servers": [
    {
      "url": "https://fmr-mock.onrender.com",
      "description": "Render"
    },
    {
      "url": "http://localhost:8080",
      "description": "Local"
    }
  ]
}