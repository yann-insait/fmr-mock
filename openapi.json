            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "SendFormIn": {
        "properties": {
          "email": {
            "type": "string",
            "title": "Email",
            "description": "Recipient. A `@fail.com` / `@error.com` address simulates a failed send (500).",
            "examples": [
              "customer@example.com"
            ]
          },
          "formName": {
            "type": "string",
            "enum": [
              "kubiot",
              "nispah5"
            ],
            "title": "Formname",
            "description": "Selects the `data` shape"
          },
          "data": {
            "title": "Data",
            "description": "Form fields. `kubiot` → KubiotData, `nispah5` → Nispah5Data",
            "oneOf": [
              {
                "$ref": "#/components/schemas/KubiotData"
              },
              {
                "$ref": "#/components/schemas/Nispah5Data"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "email",
          "formName",
          "data"
        ],
        "title": "SendFormIn"
      },
      "SendFormOut": {
        "properties": {
          "Status": {
            "type": "integer",
            "title": "Status",
            "default": 200,
            "examples": [
              200
            ]
          },
          "Message": {
            "type": "string",
            "title": "Message"
          },
          "FormName": {
            "type": "string",
            "title": "Formname"
          },
          "ReferenceID": {
            "type": "string",
            "title": "Referenceid"
          }
        },
        "type": "object",
        "required": [
          "Message",
          "FormName",
          "ReferenceID"
        ],
        "title": "SendFormOut"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
